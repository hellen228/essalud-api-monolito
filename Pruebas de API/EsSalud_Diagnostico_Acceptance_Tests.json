			"name": "Diagnóstico Clínico",
			"item": [
				{
					"name": "TC01 - Asignar Diagnóstico CIE-10",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// =====================================================================",
									"// PRUEBA DE ACEPTACIÓN BDD",
									"// GIVEN: Una atención médica activa (idAtencion: 1)",
									"// WHEN: Se asigna un diagnóstico CIE-10",
									"// THEN: El sistema retorna 201 Created con el diagnóstico en estado ACTIVO",
									"// =====================================================================",
									"",
									"pm.test(\"THEN - Código de estado HTTP es 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"THEN - Diagnóstico asignado con código CIE-10\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData.codigoCie10).to.eql('J18.9');",
									"    pm.expect(jsonData.estado).to.eql('ACTIVO');",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"idAtencion\": 1,\n  \"codigoCie10\": \"J18.9\",\n  \"descripcion\": \"Neumonía no especificada\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
